# Local web server
# Hosting platforms may supply PORT; STEAM_PROFIT_SERVER_ADDR takes precedence.
PORT=
STEAM_PROFIT_SERVER_ADDR=127.0.0.1:8080
STEAM_PROFIT_STORAGE=sqlite
STEAM_PROFIT_DATABASE_FILE=steam-profit.db
STEAM_PROFIT_RECORD_FILE=steam-profit-records.csv
STEAM_PROFIT_IMPORT_CSV=

# Optional controlled-demo boundary. Configure both credentials together.
STEAM_PROFIT_DEMO_USERNAME=
STEAM_PROFIT_DEMO_PASSWORD=
STEAM_PROFIT_RATE_LIMIT_PER_MINUTE=0
STEAM_PROFIT_AI_RUNS_PER_HOUR=0
STEAM_PROFIT_TRUST_PROXY_HEADERS=false

# Steam market lookup provider
STEAM_PROFIT_LOOKUP_PROVIDER=steam_public
STEAM_PROFIT_LOOKUP_BASE_URL=https://steamcommunity.com
STEAM_PROFIT_LOOKUP_APP_ID=730
STEAM_PROFIT_LOOKUP_TIMEOUT_MS=5000
STEAM_PROFIT_LOOKUP_USER_AGENT=steam-profit-calculator/lookup

# Optional provider authentication
STEAM_PROFIT_LOOKUP_API_KEY=
STEAM_PROFIT_LOOKUP_API_KEY_HEADER=X-API-Key

# Optional AI strategy assistant (disabled by default)
STEAM_PROFIT_AI_PROVIDER=disabled
STEAM_PROFIT_AI_BASE_URL=https://api.openai.com/v1
STEAM_PROFIT_AI_MODEL=gpt-5.6-terra
STEAM_PROFIT_AI_REASONING_EFFORT=low
STEAM_PROFIT_AI_VERBOSITY=low
STEAM_PROFIT_AI_MAX_OUTPUT_TOKENS=1200
STEAM_PROFIT_AI_TIMEOUT_MS=25000

# Required only when STEAM_PROFIT_AI_PROVIDER=openai.
# OPENAI_API_KEY is also accepted as a fallback.
STEAM_PROFIT_AI_API_KEY=
